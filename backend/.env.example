PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/paycheck_upi
CLIENT_ORIGIN=http://localhost:5173

# ---------------- LIVE UPI / VPA VERIFICATION ----------------
# IMPORTANT: Never put these secrets in frontend code or commit them to GitHub.
# Keep this false until you have an authorized verification provider account.
UPI_LIVE_VERIFICATION=false

# Provider: payu or cashfree
VPA_PROVIDER=payu

# -------- PayU V2 Validate VPA --------
PAYU_MERCHANT_KEY=
PAYU_MERCHANT_SECRET=
PAYU_VPA_VERIFY_URL=https://info.payu.in/payment-mode/v1/upi/vpa

# -------- Cashfree Payouts Validate VPA (alternative) --------
# Use Cashfree Payouts credentials, not ordinary Payments credentials.
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
# Production: https://payout-api.cashfree.com
# Sandbox:    https://payout-gamma.cashfree.com
CASHFREE_BASE_URL=https://payout-api.cashfree.com
